# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
/site/

# Local scratch / working notes (never committed)
.scratch/

# Virtual environments. `.venv*/` also covers a side env built on another
# backend (e.g. `.venv-cuda/`). uv writes its own `*` .gitignore inside a venv,
# but that file is disposable, so the top-level rule is what we rely on.
.venv*/
venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.mypy/

# Editors / OS
.DS_Store
*.swp

# Byte-compiled / native
*.so

# Jupyter Notebooks. The notebook is source; the checkpoints beside it are not.
.ipynb_checkpoints/

# Experiment run artifacts (regenerated, not source)
experiments/results/
experiments/figures/